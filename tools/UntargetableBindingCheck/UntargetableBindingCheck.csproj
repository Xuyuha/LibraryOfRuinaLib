<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CompatibilityTarget Condition="'$(CompatibilityTarget)' == ''">0.113.1</CompatibilityTarget>
    <LibraryAssemblyPath Condition="'$(LibraryAssemblyPath)' == ''">../../build/bin/LibraryLib/$(CompatibilityTarget)/Release/net9.0/LibraryOfRuinaLib.dll</LibraryAssemblyPath>
  </PropertyGroup>
  <Target Name="RequireGameRefs" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(GameManagedDir)/sts2.dll')" Text="Pass GameManagedDir pointing to the target game's managed DLL directory." />
  </Target>
  <ItemGroup>
    <Reference Include="LibraryOfRuinaLib" HintPath="$(LibraryAssemblyPath)" Private="true" />
    <Reference Include="sts2" HintPath="$(GameManagedDir)/sts2.dll" Private="true" />
    <Reference Include="GodotSharp" HintPath="$(GameManagedDir)/GodotSharp.dll" Private="true" />
    <Reference Include="0Harmony" HintPath="$(GameManagedDir)/0Harmony.dll" Private="true" />
  </ItemGroup>
</Project>
