<Project Sdk="Microsoft.NET.Sdk">
  <!-- 自包含构建工程；Directory.Build.props 按 CompatibilityTarget 选择原版引用与输出目录。 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>LibraryOfRuinaLib</AssemblyName>
    <RootNamespace>LibraryLib</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8632;CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Compile Remove=".godot/**;bin/**;obj/**;build/**;tests/**;.tests/**;loader/**;tools/**;dist/**" />
  </ItemGroup>
</Project>
