<Project Sdk="Microsoft.NET.Sdk">
  <!-- Copied into the LibraryOfRuinaLib checkout by tools/build_lib.sh: the upstream repository does not commit
       its project file. Only used to compile against the library's current source; the release build is the
       library author's. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>LibraryOfRuinaLib</AssemblyName>
    <RootNamespace>LibraryLib</RootNamespace>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS8632;CS0436</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="sts2" HintPath="$(Sts2DataDir)/sts2.dll" Private="false" />
    <Reference Include="0Harmony" HintPath="$(Sts2DataDir)/0Harmony.dll" Private="false" />
    <Reference Include="GodotSharp" HintPath="$(Sts2DataDir)/GodotSharp.dll" Private="false" />
    <Compile Remove=".godot/**;bin/**;obj/**;build/**;tests/**;.tests/**;loader/**;tools/**;dist/**" />
  </ItemGroup>
</Project>
