<Project>
  <PropertyGroup>
    <CompatibilityTarget Condition="'$(CompatibilityTarget)' == ''">0.111.0</CompatibilityTarget>
    <GameRefsRoot Condition="'$(GameRefsRoot)' == ''">$(HOME)/sts2-mods/HextechRunes/versioned-dll-backups</GameRefsRoot>
    <Sts2DataDir>$(GameRefsRoot)/$(CompatibilityTarget)/game-refs</Sts2DataDir>
    <!-- 防止仓库内 libs/sts2.dll 抢先于指定版本的 HintPath。 -->
    <AssemblySearchPath_UseCandidateAssemblyFiles>false</AssemblySearchPath_UseCandidateAssemblyFiles>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)build/obj/$(MSBuildProjectName)/$(CompatibilityTarget)/</BaseIntermediateOutputPath>
    <BaseOutputPath>$(MSBuildThisFileDirectory)build/bin/$(MSBuildProjectName)/$(CompatibilityTarget)/</BaseOutputPath>
    <!-- Godot.NET.Sdk 在导入本文件前已把两者指向共享的 .godot/mono/temp，这里改回按目标隔离；普通 SDK 下与默认值相同。 -->
    <OutputPath>$(BaseOutputPath)$(Configuration)/</OutputPath>
    <IntermediateOutputPath>$(BaseIntermediateOutputPath)$(Configuration)/</IntermediateOutputPath>
    <DefineConstants Condition="'$(CompatibilityTarget)' == '0.107.1'">$(DefineConstants);STS2_0_107_1</DefineConstants>
    <DefineConstants Condition="'$(CompatibilityTarget)' == '0.111.0'">$(DefineConstants);STS2_0_111_0</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="LibraryOfRuinaLibCompatibilityTarget" Value="$(CompatibilityTarget)" />
  </ItemGroup>
  <Target Name="ValidateCompatibilityTarget" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(CompatibilityTarget)' != '0.107.1' and '$(CompatibilityTarget)' != '0.111.0'" Text="仅支持 CompatibilityTarget=0.107.1 或 0.111.0。" />
    <Error Condition="!Exists('$(Sts2DataDir)/sts2.dll')" Text="缺少目标游戏引用：$(Sts2DataDir)/sts2.dll" />
  </Target>
</Project>
